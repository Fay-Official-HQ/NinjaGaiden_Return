[gd_scene format=3 uid="uid://vsqoot7w2gvc"]

[sub_resource type="GDScript" id="GDScript_n5ekt"]
script/source = "# res://scripts/environment/CameraModeSwitch.gd
extends Area2D
class_name CameraModeSwitch

# ════════════════════════════
#  进入区域时的摄像机设置
# ════════════════════════════
## 锁定 X 轴（勾选 = 相机固定在进入瞬间的X，不跟随玩家水平移动）
## 与 follow_x 互斥：lock_x 优先，两者都不勾选 = 不改变该轴
@export var lock_x: bool = false
## 跟随玩家 X（勾选 = 相机跟随玩家左右移动）
@export var follow_x: bool = true
## 锁定 Y 轴（勾选 = 相机固定在进入瞬间的Y，不跟随玩家垂直移动）
## 与 follow_y 互斥：lock_y 优先，两者都不勾选 = 不改变该轴
@export var lock_y: bool = false
## 跟随玩家 Y（勾选 = 相机跟随玩家上下移动）
@export var follow_y: bool = true

## 进入区域后摄像机的 X 偏移（相对进入瞬间的相机位置，像素）
## 正数 = 右移，负数 = 左移
@export var offset_x: float = 0.0
## 进入区域后摄像机的 Y 偏移（相对进入瞬间的相机位置，像素）
## 正数 = 下移，负数 = 上移
@export var offset_y: float = 0.0

# ════════════════════════════
#  离开区域时的摄像机设置
# ════════════════════════════
## 离开时锁定 X 轴（勾选 = 出去后相机固定在当前X，不跟随玩家X）
## 与 exit_follow_x 互斥：exit_lock_x 优先，两者都不勾选 = 不改变该轴
@export var exit_lock_x: bool = false
## 离开时跟随玩家 X（勾选 = 出去后相机跟随玩家左右移动）
@export var exit_follow_x: bool = true
## 离开时锁定 Y 轴（勾选 = 出去后相机固定在当前Y，不跟随玩家Y）
## 与 exit_follow_y 互斥：exit_lock_y 优先，两者都不勾选 = 不改变该轴
@export var exit_lock_y: bool = false
## 离开时跟随玩家 Y（勾选 = 出去后相机跟随玩家上下移动）
@export var exit_follow_y: bool = true
## 离开时摄像机在玩家 X 居中（跟随X，且位置对齐到玩家X）
@export var exit_center_x: bool = false
## 离开时摄像机在玩家 Y 居中（跟随Y，且位置对齐到玩家Y）
@export var exit_center_y: bool = false

## 进入区域后设置的左右边界（-1 = 保持原边界）
@export var bound_left: int = -1
@export var bound_right: int = -1
## 进入区域后设置的上下边界（-1 = 保持原边界）
@export var bound_top: int = -1
@export var bound_bottom: int = -1

## 过渡平滑时间（秒），0 = 瞬间切换
@export var transition_duration: float = 0.5

var _camera: PlayerCamera

func _ready() -> void:
	body_entered.connect(_on_body_entered)
	body_exited.connect(_on_body_exited)


func _on_body_entered(body: Node2D) -> void:
	if not body is Player:
		return
	_camera = body.get_node_or_null(\"Camera2D\") as PlayerCamera
	if not _camera:
		return

	# 每次进入都重新应用设置（可重复触发）
	var new_lock_x: bool = _camera.lock_x
	if lock_x:
		new_lock_x = true
	elif follow_x:
		new_lock_x = false

	var new_lock_y: bool = _camera.lock_y
	if lock_y:
		new_lock_y = true
	elif follow_y:
		new_lock_y = false

	# 目标位置 = 进入瞬间相机位置 + 偏移
	var target_fixed_x: float = _camera.global_position.x + offset_x
	var target_fixed_y: float = _camera.global_position.y + offset_y

	_camera.smooth_transition(new_lock_x, new_lock_y,
							target_fixed_x, target_fixed_y,
							transition_duration)
	_apply_bounds()


func _on_body_exited(body: Node2D) -> void:
	if not body is Player or not _camera:
		return

	var player := body as Player
	var new_lock_x: bool = _camera.lock_x
	var target_fixed_x: float = _camera.global_position.x
	if exit_lock_x:
		new_lock_x = true
	elif exit_follow_x:
		new_lock_x = false
	if exit_center_x:
		new_lock_x = false
		target_fixed_x = player.global_position.x

	var new_lock_y: bool = _camera.lock_y
	var target_fixed_y: float = _camera.global_position.y
	if exit_lock_y:
		new_lock_y = true
	elif exit_follow_y:
		new_lock_y = false
	if exit_center_y:
		new_lock_y = false
		target_fixed_y = player.global_position.y

	_camera.smooth_transition(new_lock_x, new_lock_y,
							target_fixed_x, target_fixed_y, transition_duration)


func _apply_bounds() -> void:
	_camera.set_bounds(bound_left, bound_right, bound_top, bound_bottom)
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_jiu1u"]
size = Vector2(64, 64)

